{
  "name": "theme",
  "version": "3.8.0",
  "engines": {
    "node": ">=22.23.1"
  },
  "description": "",
  "scripts": {
    "start": "npm run dev",
    "build": "npm run build:clean && npm run build:tailwind",
    "build:clean": "rimraf ../static/css/dist",
    "build:tailwind": "cross-env NODE_ENV=production tailwindcss -i ./src/styles.css -o ../static/css/dist/styles.css --minify",
    "dev": "cross-env NODE_ENV=development tailwindcss -i ./src/styles.css -o ../static/css/dist/styles.css -w",
    "tailwindcss": "tailwindcss"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "cross-env": "^10.1.0",
    "daisyui": "^5.7.22",
    "postcss": "^8.5.26",
    "postcss-import": "^17.0.0",
    "postcss-nested": "^8.0.1",
    "postcss-simple-vars": "^7.0.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@fontsource-variable/work-sans": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4"
  }
}
